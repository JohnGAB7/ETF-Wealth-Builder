# ValueInvesting.io: existing subscription covers US and Canadian equities only.
VALUEINVESTING_API_KEY=

# Optional provider keys.
FINNHUB_API_KEY=
# FRED requires a free API key. ECB Data Portal and Eurostat do NOT require keys.
FRED_API_KEY=

# Email delivery (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Runtime.
LOG_LEVEL=INFO
